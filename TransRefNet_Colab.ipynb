  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "DATASETS = ['kvasir', 'clinicdb', 'isic2018', 'dsb2018']\n",
    "\n",
    "for dataset in DATASETS:\n",
    "    print(f'\\n{\"=\"*60}')\n",
    "    print(f'  Training ConvSegNet on {dataset.upper()}')\n",
    "    print(f'{\"=\"*60}\\n')\n",
