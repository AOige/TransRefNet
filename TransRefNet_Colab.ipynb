    "---\n",
    "## 5 — DSB 2018 Mask Preprocessing *(run once)*\n",
    "\n",
    "The DSB 2018 competition stores one binary mask per nucleus per image.  \n",
    "This step merges them into a single mask per sample and saves the results to `dsb2018_merged_masks/`.  \n",
    "**Run this cell only once** — subsequent runs of `train.py` and `test.py` will use the merged masks directly."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "merged_dir = os.path.join(DATA_ROOT, 'dsb2018_merged_masks')\n",
    "\n",
    "if os.path.isdir(merged_dir) and len(os.listdir(merged_dir)) > 100:\n",
    "    print(f'Merged masks already exist ({len(os.listdir(merged_dir))} files). Skipping.')\n",
    "else:\n",
    "    from dataset import prepare_dsb2018\n",
    "    prepare_dsb2018(DATA_ROOT)\n",
    "    print('Preprocessing complete.')"
   ]
  },
