   "source": [
    "---\n",
    "## 6 — Train TransRefNet (Proposed)\n",
    "\n",
    "Trains TransRefNet on all four datasets sequentially.  \n",
    "Checkpoints are saved to Drive and survive session restarts."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "DATASETS = ['kvasir', 'clinicdb', 'isic2018', 'dsb2018']\n",
    "\n",
    "for dataset in DATASETS:\n",
    "    print(f'\\n{\"=\"*60}')\n",
    "    print(f'  Training TransRefNet on {dataset.upper()}')\n",
    "    print(f'{\"=\"*60}\\n')\n",
    "    !python train.py \\\n",
    "        --model      transrefnet \\\n",
    "        --dataset    {dataset} \\\n",
    "        --data_root  {DATA_ROOT} \\\n",
    "        --save_dir   {CKPT_DIR} \\\n",
    "        --epochs     300 \\\n",
    "        --batch_size 8 \\\n",
    "        --img_size   256 \\\n",
    "        --lr         1e-4 \\\n",
    "        --patience   50 \\\n",
    "        --seed       42"
   ]
